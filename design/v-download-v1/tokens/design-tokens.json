{
  "name": "V-Download Desktop UI Tokens",
  "mode": "semantic-grayscale",
  "color": {
    "background": {
      "app": "#101114",
      "window": "#101114",
      "sidebar": "#15161A"
    },
    "surface": {
      "base": "#1C1F25",
      "raised": "#22252C",
      "elevated": "#292D35",
      "control": "rgba(255,255,255,0.055)"
    },
    "border": {
      "default": "rgba(255,255,255,0.12)",
      "strong": "rgba(255,255,255,0.22)",
      "focus": "rgba(255,255,255,0.34)"
    },
    "text": {
      "primary": "#F4F4F6",
      "secondary": "#A4A9B4",
      "tertiary": "#838A97",
      "inverse": "#101114"
    },
    "accent": {
      "primary": "#FFFFFF",
      "primaryText": "#050505",
      "subtle": "rgba(255,255,255,0.10)"
    },
    "state": {
      "success": "#4ADE80",
      "warning": "#FBBF24",
      "error": "#F87171",
      "info": "#60A5FA"
    },
    "selection": "#292D35"
  },
  "typography": {
    "family": "-apple-system, BlinkMacSystemFont, SF Pro Text, Inter, Segoe UI, Roboto, Helvetica, Arial, Noto Sans CJK SC, sans-serif",
    "windowTitle": {
      "size": 13,
      "weight": 800,
      "lineHeight": 16
    },
    "pageTitle": {
      "size": 24,
      "weight": 800,
      "lineHeight": 30,
      "letterSpacing": -0.03
    },
    "sectionTitle": {
      "size": 15,
      "weight": 600,
      "lineHeight": 20
    },
    "rowTitle": {
      "size": 14,
      "weight": 600,
      "lineHeight": 19
    },
    "body": {
      "size": 13,
      "weight": 400,
      "lineHeight": 20
    },
    "metadata": {
      "size": 12,
      "weight": 500,
      "lineHeight": 16
    },
    "label": {
      "size": 10,
      "weight": 850,
      "lineHeight": 12,
      "letterSpacing": 0.09
    }
  },
  "spacing": {
    "base": 8,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "button": 8,
    "card": 10,
    "panel": 12,
    "window": 16,
    "pill": 6
  },
  "shadow": {
    "window": "0 22px 70px rgba(0,0,0,0.58)",
    "modal": "0 12px 40px rgba(0,0,0,0.24)",
    "accent": "none"
  },
  "layout": {
    "mainWindow": {
      "width": 1328,
      "height": 848
    },
    "sidebarWidth": 244,
    "inspectorWidth": 328,
    "titlebarHeight": 52,
    "rowHeight": 98
  },
  "light": {
    "background": {
      "window": "#FAFAFA",
      "sidebar": "#F1F2F4"
    },
    "surface": "#FFFFFF",
    "selection": "#E8EBEF",
    "text": {
      "primary": "#171717",
      "secondary": "#666A73"
    },
    "action": {
      "background": "#171717",
      "text": "#FFFFFF"
    }
  }
}
