{
  "name": "v-download",
  "version": "1.1.7",
  "description": "A Downie-style video downloader for YouTube, Douyin, and any website, powered by yt-dlp",
  "main": "./out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:preflight": "node scripts/dev-native-preflight.mjs",
    "test:dev-native-preflight": "node scripts/test-dev-native-preflight.mjs",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:web && npm run typecheck:node",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run test:selection && npm run test:grouped-queue && npm run test:info-resolution && npm run test:info-resolution-contract && npm run test:douyin-profile && npm run test:douyin-gallery && npm run test:profile-picker-selection && npm run test:foundation && npm run test:media-resolver && npm run test:media-identity && npm run test:ytdlp-progress && npm run test:engine-manager && npm run test:onboarding && npm run test:native-auth && npm run test:transcode && npm run test:i18n && npm run test:queue-filters && npm run test:presentation && npm run test:thumbnail-fetch && npm run test:http-client && npm run test:extension && npm run test:ui-contract && npm run test:api-jobs && npm run test:remote-api && npm run test:remote-job && npm run test:python-framework",
    "test:selection": "npx tsx scripts/test-selection.ts",
    "test:grouped-queue": "npx tsx scripts/test-grouped-queue-scheduler.ts",
    "test:info-resolution": "npx tsx scripts/test-info-resolution-scheduler.ts",
    "test:info-resolution-contract": "npx tsx scripts/test-info-resolution-contract.ts",
    "test:foundation": "npx tsx scripts/test-foundation.ts",
    "build:mac": "node scripts/build-mac-release.mjs",
    "build:mac:arm64": "node scripts/build-mac-release.mjs arm64",
    "build:mac:x64": "node scripts/build-mac-release.mjs x64",
    "verify:release": "node scripts/verify-release.mjs",
    "fetch:engines": "node scripts/engines.mjs fetch",
    "verify:engines": "node scripts/engines.mjs verify",
    "prepare:release": "node scripts/prepare-release.mjs",
    "preview": "electron-vite preview",
    "postinstall": "npm run build --workspace=@v-download/shared && node scripts/write-extension-cookie-sync.mjs && electron-builder install-app-deps",
    "sync:extension-constants": "npm run build --workspace=@v-download/shared && node scripts/write-extension-cookie-sync.mjs",
    "test:douyin-profile": "npx tsx scripts/test-douyin-profile.ts",
    "test:douyin-gallery": "npx tsx scripts/test-douyin-gallery.ts",
    "test:profile-picker-selection": "npx tsx src/renderer/src/components/douyinProfilePickerState.test.ts",
    "test:media-resolver": "npx tsx scripts/test-media-resolver.ts",
    "test:media-identity": "npx tsx scripts/test-media-identity.ts",
    "test:ytdlp-progress": "npx tsx scripts/test-ytdlp-progress.ts",
    "test:engine-manager": "npx tsx scripts/test-engine-manager.ts",
    "test:onboarding": "npx tsx scripts/test-onboarding.ts",
    "test:native-auth": "npx tsx scripts/test-native-auth.ts",
    "test:transcode": "npx tsx scripts/test-transcode.ts",
    "test:i18n": "npx tsx scripts/test-i18n.ts",
    "test:queue-filters": "npx tsx src/renderer/src/utils/queueFilters.test.ts",
    "test:presentation": "npx tsx src/renderer/src/components/formatDialogPresentation.test.ts && npx tsx src/renderer/src/components/downloadInspectorPresentation.test.ts && npx tsx src/renderer/src/components/preferencesPanelPresentation.test.ts && npx tsx src/renderer/src/utils/queueFilters.test.ts",
    "test:extension": "node scripts/test-extension-media.js && node scripts/test-extension-download.js",
    "test:ui-contract": "node scripts/test-ui-contract.mjs",
    "test:python-framework": "node scripts/test-python-framework.mjs",
    "test:engines": "node scripts/test-engines.mjs",
    "test:thumbnail-fetch": "npx tsx scripts/test-thumbnail-fetch.ts",
    "test:http-client": "npx tsx scripts/test-http-client.ts",
    "test:api-jobs": "npx tsx scripts/test-api-jobs.ts",
    "test:remote-api": "npx tsx scripts/test-remote-api.ts",
    "test:remote-job": "npx tsx scripts/test-remote-job.ts",
    "test:release-gates": "node scripts/test-release-gates.mjs",
    "test:security": "npx tsx scripts/test-security.ts",
    "test:updater": "npx tsx scripts/test-updater-contract.ts",
    "test:production-placeholder-scan": "npx tsx scripts/test-production-placeholder-scan.ts",
    "audit:production": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@v-download/shared": "*",
    "better-sqlite3": "^11.0.0",
    "cloakbrowser": "^0.3.30",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "playwright-core": "^1.60.0",
    "react-i18next": "^17.0.11",
    "uuid": "^11.1.1",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "socks": {
      "ip-address": "^10.2.0"
    },
    "cloakbrowser": {
      "tar": "^7.5.22"
    }
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.0.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
