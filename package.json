{
  "name": "v-download",
  "version": "1.1.7",
  "description": "A Downie-style video downloader for YouTube, Douyin, and any website, powered by yt-dlp",
  "main": "./out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:preflight": "node scripts/dev-native-preflight.mjs",
    "test:dev-native-preflight": "node scripts/test-dev-native-preflight.mjs",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:web && npm run typecheck:node",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run test:grouped-queue && npm run test:douyin-profile && npm run test:foundation && npm run test:media-resolver && npm run test:extension",
    "test:grouped-queue": "npx tsx scripts/test-grouped-queue-scheduler.ts",
    "test:foundation": "npx tsx scripts/test-foundation.ts",
    "build:mac": "node scripts/build-mac-release.mjs",
    "build:mac:arm64": "node scripts/build-mac-release.mjs arm64",
    "build:mac:x64": "node scripts/build-mac-release.mjs x64",
    "verify:release": "node scripts/verify-release.mjs",
    "fetch:engines": "node scripts/engines.mjs fetch",
    "verify:engines": "node scripts/engines.mjs verify",
    "prepare:release": "node scripts/prepare-release.mjs",
    "preview": "electron-vite preview",
    "postinstall": "npm run build --workspace=@v-download/shared && node scripts/write-extension-cookie-sync.mjs && electron-builder install-app-deps",
    "sync:extension-constants": "npm run build --workspace=@v-download/shared && node scripts/write-extension-cookie-sync.mjs",
    "test:douyin-profile": "npx tsx scripts/test-douyin-profile.ts",
    "test:media-resolver": "npx tsx scripts/test-media-resolver.ts",
    "test:extension": "node scripts/test-extension-media.js && node scripts/test-extension-download.js",
    "test:engines": "node scripts/test-engines.mjs",
    "test:release-gates": "node scripts/test-release-gates.mjs",
    "test:security": "npx tsx scripts/test-security.ts",
    "test:updater": "npx tsx scripts/test-updater-contract.ts",
    "test:production-placeholder-scan": "npx tsx scripts/test-production-placeholder-scan.ts",
    "audit:production": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@v-download/shared": "*",
    "better-sqlite3": "^11.0.0",
    "cloakbrowser": "^0.3.30",
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.60.0",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "socks": {
      "ip-address": "^10.2.0"
    },
    "cloakbrowser": {
      "tar": "^7.5.20"
    }
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.0.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0",
    "three": "^0.183.2",
    "typescript": "^5.7.0"
  }
}
