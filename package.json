{
  "name": "v-download",
  "version": "1.1.7",
  "engines": {
    "node": ">=22.14.0 <23 || >=23.6.0"
  },
  "description": "A Downie-style video downloader for YouTube, Douyin, and any website, powered by yt-dlp",
  "author": "V-Download Contributors <support@v-download.app>",
  "main": "./out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:preflight": "node scripts/dev-native-preflight.mjs",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:web && npm run typecheck:node",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build:mac": "node scripts/build-mac-release.mjs",
    "build:mac:arm64": "node scripts/build-mac-release.mjs arm64",
    "build:mac:x64": "node scripts/build-mac-release.mjs x64",
    "build:linux": "node scripts/build-linux-release.mjs",
    "build:linux:x64": "node scripts/build-linux-release.mjs x64",
    "build:linux:arm64": "node scripts/build-linux-release.mjs arm64",
    "build:linux:deb": "node scripts/build-linux-release.mjs x64 --target=deb",
    "build:linux:appimage": "node scripts/build-linux-release.mjs x64 --target=AppImage",
    "verify:release": "node scripts/verify-release.mjs",
    "fetch:engines": "node scripts/engines.mjs fetch",
    "verify:engines": "node scripts/engines.mjs verify",
    "prepare:release": "node scripts/prepare-release.mjs",
    "preview": "electron-vite preview",
    "postinstall": "npm run build --workspace=@v-download/shared && node scripts/write-extension-cookie-sync.mjs && node node_modules/electron/install.js",
    "sync:extension-constants": "npm run build --workspace=@v-download/shared && node scripts/write-extension-cookie-sync.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@v-download/shared": "*",
    "better-sqlite3": "13.0.3",
    "cloakbrowser": "^0.3.30",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "playwright-core": "^1.60.0",
    "react-i18next": "^17.0.11",
    "undici": "^6.28.1",
    "uuid": "^11.1.1",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "socks": {
      "ip-address": "^10.3.1"
    },
    "cloakbrowser": {
      "tar": "^7.5.22"
    }
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.0",
    "electron": "43.7.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3"
  }
}
